# BotPanel configuration.
# Copy to .env and change what you need — every value below is optional and
# shows its default.

# --- Network -----------------------------------------------------------------

# Address and port the panel binds to.
HOST=0.0.0.0
PORT=8080

# Absolute URL where users reach the panel. Only needed when it runs behind a
# reverse proxy or a domain, so that generated webhook URLs are correct.
# Can also be set from the Administration page.
# PUBLIC_URL=https://bots.example.com

# Set to 1 when a proxy terminates TLS in front of the panel, so that client IPs
# and generated URLs come from the X-Forwarded-* headers.
TRUST_PROXY=0

# Set to 1 when the panel is served over HTTPS.
SECURE_COOKIES=0

# --- Storage -----------------------------------------------------------------

# Bot checkouts, logs, backups and the SQLite database.
# Relative paths resolve against the install directory.
DATA_DIR=./data

# --- Identity ----------------------------------------------------------------

# Name shown before an administrator sets one from the Administration page.
INSTANCE_NAME=BotPanel

# Signs session cookies. Generated and saved to <DATA_DIR>/secret.key if unset.
# Set this explicitly to share sessions across replicas.
# SESSION_SECRET=

# How long a sign-in lasts, in days.
SESSION_DAYS=30

# --- Tuning ------------------------------------------------------------------

# Console lines held in memory per bot, and log file size before rotation.
LOG_RING_SIZE=2000
LOG_MAX_BYTES=5242880

# Resource sampling interval in milliseconds, and how long samples are kept.
METRICS_INTERVAL_MS=3000
METRICS_RETENTION_DAYS=7

# Time a bot gets to exit after SIGTERM before it is killed, in milliseconds.
STOP_GRACE_MS=10000

# Maximum time a dependency install may run, in milliseconds.
INSTALL_TIMEOUT_MS=1200000
